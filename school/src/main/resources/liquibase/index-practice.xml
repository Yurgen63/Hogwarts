<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1-idx-student-name-lower" author="student">
        <sql>CREATE INDEX IF NOT EXISTS idx_student_name_lower ON students (LOWER(name));</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS idx_student_name_lower;</sql>
        </rollback>
    </changeSet>

        <changeSet id="3-idx-faculty-name-lower" author="student">
            <sql>CREATE INDEX IF NOT EXISTS idx_faculty_name_lower ON faculties (LOWER(name));</sql>
            <rollback>
                <sql>DROP INDEX IF EXISTS idx_faculty_name_lower;</sql>
            </rollback>
        </changeSet>

            <changeSet id="4-idx-faculty-color-lower" author="student">
                <sql>CREATE INDEX IF NOT EXISTS idx_faculty_color_lower ON faculties (LOWER(color));</sql>
                <rollback>
                    <sql>DROP INDEX IF EXISTS idx_faculty_color_lower;</sql>
                </rollback>
            </changeSet>
</databaseChangeLog>